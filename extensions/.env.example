# Google Ads API Configuration
# Copy this to .env and fill in your actual values

# Authentication type: "oauth" or "service_account"
GOOGLE_ADS_AUTH_TYPE=service_account

# Path to your credentials file (full path recommended)
GOOGLE_ADS_CREDENTIALS_PATH=/full/path/to/your/service-account-key.json

# Your Google Ads API Developer Token
# Get this from https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# Optional: Manager Account ID (if using MCC)
# Format: 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# OAuth Configuration (only if using OAuth instead of service account)
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token

# Ad Creation Settings
DEFAULT_AD_STATUS=PAUSED
DEFAULT_CAMPAIGN_STATUS=PAUSED
MAX_HEADLINES_PER_RSA=15
MAX_DESCRIPTIONS_PER_RSA=4

# Asset Upload Settings
MAX_IMAGE_SIZE_MB=5
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif
DEFAULT_BUSINESS_NAME=Your Digital Marketing Agency

# API Rate Limiting
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
BULK_OPERATION_BATCH_SIZE=100

# Validation Settings
ENABLE_STRICT_VALIDATION=true
AUTO_FIX_CHARACTER_LIMITS=false

# Asset Management
ASSET_UPLOAD_ENABLED=true
ASSET_CDN_BASE_URL=

# Debugging
LOG_LEVEL=INFO
DEBUG_MODE=false